{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
    {% if block_settings.label contains 'SHOP NOW' or block_settings.label contains 'BUY NOW' or block_settings.label contains 'CHOOSE GIFT' %}tisso-btn tisso-btn--black{% endif %}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  <span class="button__label">{{ block_settings.label }}</span>
  {%- if block_settings.label contains 'SHOP NOW' or block_settings.label contains 'BUY NOW' or block_settings.label contains 'CHOOSE GIFT' or block_settings.show_arrow -%}
    <span class="tisso-btn__arrow" aria-hidden="true" style="display: inline-flex; align-items: center; margin-inline-start: 8px;">
      <svg width="16" height="12" viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 1L15 6M15 6L10 11M15 6H1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  {%- endif -%}
</a>
